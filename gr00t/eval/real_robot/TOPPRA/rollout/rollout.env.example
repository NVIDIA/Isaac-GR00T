PYTHON_BIN=.venv/bin/python
ROS_SETUP=/opt/ros/noetic/setup.bash
# Set this to the catkin workspace that provides the Kion message/service packages.
ROBOT_ROS_SETUP=

# plain | speed-rl | speed-rl-baseline
ROLLOUT_MODE=plain
INFERENCE_MODE=sync
CONTROL_INTERFACE=both
ROS_NAMESPACE=/gr00t_rollout
OBSERVATION_GUI_ROOT=/absolute/path/to/ObservationGUILite-v1.0.0
# native reuses this repository's Python 3.12 environment and avoids the large Docker build.
# docker remains available for machines with unrestricted access to Astral/GitHub downloads.
OBSERVATION_GUI_RUNTIME=native
OBSERVATION_GUI_PYTHON=.venv/bin/python

POLICY_SERVER_HOST=127.0.0.1
POLICY_SERVER_PORT=47866
TIMEOUT_MS=15000
TASK="move parcel onto conveyor belt one by one"
POLICY_FREQUENCY=30
CONTROL_FREQUENCY=250
# Synchronous rollout uses exactly one candidate. Do not set this to 4/8 unless explicitly
# benchmarking TTS, because server inference and returned features are replicated per candidate.
TTS_SAMPLES=1
TTS_WAYPOINT_COUNT=5
REFILL_THRESHOLD=20
# Set at or above the measured server+network P99 before asynchronous real-robot validation.
MAX_LATENCY_S=0.35
SCHEDULING_MARGIN_S=0.05
HANDOFF_MARGIN_S=0.05
OPEN_LOOP_HORIZON=8
VELOCITY_FILTER=1.0
SERVO_GAIN=800
STARTUP_TIMEOUT_S=30
MAX_STATE_AGE_S=0.25
MAX_IMAGE_AGE_S=1.0
EPISODE_DURATION_S=80
PINCH_MAX_RATE_HZ=30
# manual only releases Servo; go-home additionally calls the SDK dual-arm Trigger service.
# Both modes still require the operator to confirm Reset Complete / Ready.
RESET_MODE=manual
RESET_SERVICE=/zj_humanoid/upperlimb/go_home/dual_arm
RESET_TIMEOUT_S=10
DRY_RUN=1
DISABLE_PINCH=0

# Required when DRY_RUN=0. Values must be certified for the actual robot/workcell; no defaults.
# Format: xmin,xmax,ymin,ymax,zmin,zmax in metres, expressed in the TCP pose base frame.
LEFT_WORKSPACE_BOUNDS=
RIGHT_WORKSPACE_BOUNDS=
MAX_TARGET_POSITION_ERROR_M=
MAX_TARGET_ROTATION_ERROR_RAD=

LEFT_CAMERA_TOPIC=/zj_humanoid/sensor/left_wrist/image_raw/compressed
RIGHT_CAMERA_TOPIC=/zj_humanoid/sensor/right_wrist/image_raw/compressed
HEAD_CAMERA_TOPIC=/zj_humanoid/sensor/realsense_head/color/image_raw/compressed

# Plain TOPPRA constraints. Confirm these limits against the robot before DRY_RUN=0.
MAX_LINEAR_VELOCITY=1.0
MAX_ANGULAR_VELOCITY=3.0
MAX_LINEAR_ACCELERATION=5.0
MAX_ANGULAR_ACCELERATION=15.0
SAFETY_MARGIN=0.9
PLAIN_LOG_ROOT=logs/kion_rollout

# Speed-RL options. These measured-twist thresholds have no default by design.
SPEED_RL_PHASE=calibration
LEFT_TWIST_THRESHOLDS=
RIGHT_TWIST_THRESHOLDS=
SPEED_RL_STATE_ROOT=logs/kion_speed_rl/state
SPEED_RL_LOG_ROOT=logs/kion_speed_rl/episodes
SPEED_RL_CHECKPOINT=
# The interpolation baseline changes its absolute target at 30 Hz while the Servo owner republishes
# that held target from the same 250 Hz control loop. Keep its replay/checkpoint separate from TOPPRA.
BASELINE_ACTION_FREQUENCY=30
BASELINE_K_SKIP=10
BASELINE_SPEED_MIN=1.0
BASELINE_SPEED_MAX=4.0
BASELINE_SPEED_STEP=0.5
TOPPRA_SPEED_MIN=0.7
TOPPRA_SPEED_MAX=1.6
TOPPRA_SPEED_STEP=0.3
POLICY_CHUNK_HORIZON=40
TOPPRA_EXECUTION_HORIZON=30
RAINBOW_HIDDEN_DIM=256
ONLINE_EPISODES=100
BASELINE_SPEED_RL_STATE_ROOT=logs/kion_speed_rl_baseline/state
BASELINE_SPEED_RL_LOG_ROOT=logs/kion_speed_rl_baseline/episodes
BASELINE_SPEED_RL_CHECKPOINT=
ASYNC_VERIFICATION=
