PYTHON_BIN=.venv/bin/python
ROS_SETUP=/opt/ros/noetic/setup.bash
ROBOT_ROS_SETUP=

# This file is deliberately localhost-only. launch_local_sim.sh rejects any other master.
ROS_MASTER_URI=http://127.0.0.1:11312
ROS_IP=127.0.0.1

POLICY_SERVER_HOST=127.0.0.1
POLICY_SERVER_PORT=47866
TIMEOUT_MS=15000
TASK="move parcel onto conveyor belt one by one"

ROLLOUT_MODE=plain
INFERENCE_MODE=sync
CONTROL_INTERFACE=terminal
ROS_NAMESPACE=/gr00t_local_sim_rollout
POLICY_FREQUENCY=30
CONTROL_FREQUENCY=250
TTS_SAMPLES=1
TTS_WAYPOINT_COUNT=5
REFILL_THRESHOLD=20
MAX_LATENCY_S=0.35
SCHEDULING_MARGIN_S=0.05
HANDOFF_MARGIN_S=0.05
OPEN_LOOP_HORIZON=8
VELOCITY_FILTER=1.0
SERVO_GAIN=800
STARTUP_TIMEOUT_S=10
MAX_STATE_AGE_S=0.25
MAX_IMAGE_AGE_S=1.0
EPISODE_DURATION_S=20
PINCH_MAX_RATE_HZ=30
RESET_MODE=manual
RESET_SERVICE=/zj_humanoid/upperlimb/go_home/dual_arm
RESET_TIMEOUT_S=10

# DRY_RUN must be 0 so the rollout publishes DualPose to the simulated Servo subscriber.
# These permissive bounds are for the isolated localhost simulator only, never real hardware.
DRY_RUN=0
DISABLE_PINCH=1
LEFT_WORKSPACE_BOUNDS=-2,2,-2,2,-2,2
RIGHT_WORKSPACE_BOUNDS=-2,2,-2,2,-2,2
MAX_TARGET_POSITION_ERROR_M=10
MAX_TARGET_ROTATION_ERROR_RAD=3.141592653589793

LEFT_CAMERA_TOPIC=/zj_humanoid/sensor/left_wrist/image_raw/compressed
RIGHT_CAMERA_TOPIC=/zj_humanoid/sensor/right_wrist/image_raw/compressed
HEAD_CAMERA_TOPIC=/zj_humanoid/sensor/realsense_head/color/image_raw/compressed

MAX_LINEAR_VELOCITY=1.0
MAX_ANGULAR_VELOCITY=3.0
MAX_LINEAR_ACCELERATION=5.0
MAX_ANGULAR_ACCELERATION=15.0
SAFETY_MARGIN=0.9
PLAIN_LOG_ROOT=logs/local_sim_rollout

# Used only after changing ROLLOUT_MODE to speed-rl. These are simulation-only thresholds.
SPEED_RL_PHASE=calibration
LEFT_TWIST_THRESHOLDS=100,100,100,100,100,100
RIGHT_TWIST_THRESHOLDS=100,100,100,100,100,100
SPEED_RL_STATE_ROOT=logs/local_sim_speed_rl/state
SPEED_RL_LOG_ROOT=logs/local_sim_speed_rl/episodes
SPEED_RL_CHECKPOINT=
BASELINE_ACTION_FREQUENCY=30
BASELINE_K_SKIP=10
BASELINE_SPEED_MIN=1.0
BASELINE_SPEED_MAX=4.0
BASELINE_SPEED_STEP=0.5
TOPPRA_SPEED_MIN=0.7
TOPPRA_SPEED_MAX=1.6
TOPPRA_SPEED_STEP=0.3
POLICY_CHUNK_HORIZON=40
TOPPRA_EXECUTION_HORIZON=30
RAINBOW_HIDDEN_DIM=256
ONLINE_EPISODES=100
ASYNC_VERIFICATION=
