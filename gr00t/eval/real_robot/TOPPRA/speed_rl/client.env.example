# The SSH tunnel forwards the cloud server to this local endpoint.
PYTHON_BIN=.venv/bin/python
POLICY_SERVER_HOST=127.0.0.1
POLICY_SERVER_PORT=47866
TIMEOUT_MS=15000
TASK="move parcel onto conveyor belt one by one"

# These certified measured-twist component limits are intentionally blank.
# Order: vx,vy,vz,wx,wy,wz. Fill them before running, even in dry-run mode.
LEFT_TWIST_THRESHOLDS=
RIGHT_TWIST_THRESHOLDS=

PHASE=calibration
# toppra is the main method; interpolation is the SpeedTuning-style 30 Hz comparison baseline.
EXECUTION_BACKEND=toppra
BASELINE_ACTION_FREQUENCY=30
# Baseline v advances this many nominal action indices per 30 Hz execution step.
BASELINE_K_SKIP=10
BASELINE_SPEED_MIN=1.0
BASELINE_SPEED_MAX=4.0
BASELINE_SPEED_STEP=0.5
# TOPPRA v is an independent Cartesian constraint scale.
TOPPRA_SPEED_MIN=0.7
TOPPRA_SPEED_MAX=1.6
TOPPRA_SPEED_STEP=0.3
POLICY_CHUNK_HORIZON=40
TOPPRA_EXECUTION_HORIZON=30
RAINBOW_HIDDEN_DIM=256
ONLINE_EPISODES=100
INFERENCE_MODE=sync
# Empty uses backend-specific defaults; do not share TOPPRA and interpolation replay/checkpoints.
STATE_ROOT=
LOG_ROOT=
CONTROL_FREQUENCY=250
POLICY_FREQUENCY=30
TTS_SAMPLES=1
TTS_WAYPOINT_COUNT=5
REFILL_THRESHOLD=20
MAX_LATENCY_S=0.35
SCHEDULING_MARGIN_S=0.05
HANDOFF_MARGIN_S=0.05
OPEN_LOOP_HORIZON=8
VELOCITY_FILTER=1.0
SERVO_GAIN=800
STARTUP_TIMEOUT_S=30
MAX_STATE_AGE_S=0.25
MAX_IMAGE_AGE_S=1.0
EPISODE_DURATION_S=80
PINCH_MAX_RATE_HZ=30
RESET_MODE=manual
RESET_SERVICE=/zj_humanoid/upperlimb/go_home/dual_arm
RESET_TIMEOUT_S=10
DRY_RUN=1
CONTROL_INTERFACE=gui
ROS_NAMESPACE=/gr00t_rollout
DISABLE_PINCH=0

# Required when DRY_RUN=0. Do not infer these values from software defaults.
# Format: xmin,xmax,ymin,ymax,zmin,zmax in metres in the TCP pose base frame.
LEFT_WORKSPACE_BOUNDS=
RIGHT_WORKSPACE_BOUNDS=
MAX_TARGET_POSITION_ERROR_M=
MAX_TARGET_ROTATION_ERROR_RAD=

# Optional. Source the robot's ROS workspace before Python starts.
ROS_SETUP=/opt/ros/noetic/setup.bash
ROBOT_ROS_SETUP=
LEFT_CAMERA_TOPIC=/zj_humanoid/sensor/left_wrist/image_raw/compressed
RIGHT_CAMERA_TOPIC=/zj_humanoid/sensor/right_wrist/image_raw/compressed
HEAD_CAMERA_TOPIC=/zj_humanoid/sensor/realsense_head/color/image_raw/compressed
# Optional explicit checkpoint path; otherwise STATE_ROOT/speed_rl.pt.
CHECKPOINT=
# Required only after the asynchronous rollout gates are reached.
ASYNC_VERIFICATION=
