"""Sync uv.lock into the image venv around the NGC PyTorch stack.

Usage: gr00t-sync [uv sync options], e.g. `gr00t-sync --extra training --extra dev`.
Run it from the package root instead of `uv sync`, which would replace NGC's
PyTorch with the locked one.

The NGC container provides PyTorch, torchvision, Triton, FlashAttention and the CUDA
libraries, and the image builds TorchCodec against them; the venv sees them through
--system-site-packages, so the sync skips their locked copies. NGC runs CUDA 13 on
both architectures, while the lock pins CUDA 12 builds of NVRx and TensorRT on
x86_64. There, the sync skips those and installs the versions the lock resolves for
Linux aarch64, which are CUDA 13 builds, without resolving again.
"""

import os
from pathlib import Path
import platform
import subprocess
import sys

from packaging.markers import Marker

try:
    import tomllib
except ModuleNotFoundError:  # The monorepo unit tests load this script on Python 3.10.
    import tomli as tomllib

PROJECT = "isaac-groot-n2"
NGC_PACKAGES = {"torch", "torchvision", "torchcodec", "triton", "flash-attn"}
# Wheels that link a single CUDA major. NVRx loads CUPTI and TensorRT its runtime.
CUDA_MAJOR_PACKAGES = {
    "nvidia-resiliency-ext",
    "tensorrt-cu12",
    "tensorrt-cu12-bindings",
    "tensorrt-cu12-libs",
}
AARCH64 = {
    "implementation_name": "cpython",
    "os_name": "posix",
    "platform_machine": "aarch64",
    "platform_system": "Linux",
    "python_full_version": platform.python_version(),
    "python_version": ".".join(platform.python_version_tuple()[:2]),
    "sys_platform": "linux",
}


def _requested_extras(args: list[str], available: set[str]) -> set[str]:
    if "--all-extras" in args:
        return available
    extras = set()
    for index, arg in enumerate(args):
        if arg == "--extra" and index + 1 < len(args):
            extras.add(args[index + 1])
        elif arg.startswith("--extra="):
            extras.add(arg.split("=", 1)[1])
    return extras


def _applies(dependency: dict, extra: str = "") -> bool:
    marker = dependency.get("marker")
    return marker is None or Marker(marker).evaluate({**AARCH64, "extra": extra})


def _aarch64_cuda13_pins(lock: dict, extras: set[str]) -> dict[str, str]:
    """Return the Linux aarch64 versions of the CUDA-major packages and their dependencies."""
    packages = {(p["name"], p["version"]): p for p in lock["package"]}
    versions: dict[str, list[str]] = {}
    for name, version in packages:
        versions.setdefault(name, []).append(version)

    project = next(p for p in lock["package"] if p["name"] == PROJECT)
    roots = [
        dependency
        for extra in sorted(extras)
        for dependency in project.get("optional-dependencies", {}).get(extra, [])
        if _applies(dependency, extra)
        and dependency["name"] in {"nvidia-resiliency-ext", "tensorrt-cu13"}
    ]
    pins: dict[str, str] = {}
    pending = list(roots)
    while pending:
        dependency = pending.pop()
        name = dependency["name"]
        version = dependency.get("version") or versions[name][0]
        if name in pins or name in NGC_PACKAGES or _is_cuda_library(name):
            continue
        pins[name] = version
        pending.extend(d for d in packages[(name, version)].get("dependencies", []) if _applies(d))
    return pins


def _is_cuda_library(name: str) -> bool:
    return name.startswith(("nvidia-", "cuda-")) and name not in {
        "nvidia-ml-py",
        "nvidia-resiliency-ext",
    }


def commands(lock: dict, machine: str, args: list[str], python: str) -> list[list[str]]:
    """Return the uv commands that sync ``lock`` into the venv of ``python``."""
    names = {p["name"] for p in lock["package"]}
    excluded = NGC_PACKAGES | {name for name in names if _is_cuda_library(name)}
    pins = {}
    if machine == "x86_64":
        excluded |= CUDA_MAJOR_PACKAGES
        project = next(p for p in lock["package"] if p["name"] == PROJECT)
        extras = _requested_extras(args, set(project.get("optional-dependencies", {})))
        pins = _aarch64_cuda13_pins(lock, extras)

    sync = ["uv", "sync", "--frozen", "--inexact", "--no-install-project"]
    for name in sorted(excluded & names):
        sync += ["--no-install-package", name]
    result = [[*sync, *args]]
    if pins:
        requirements = [f"{name}=={version}" for name, version in sorted(pins.items())]
        result.append(["uv", "pip", "install", "--python", python, "--no-deps", *requirements])
    return result


def main(args: list[str]) -> None:
    lock = tomllib.loads(Path("uv.lock").read_text(encoding="utf-8"))
    python = str(Path(os.environ["UV_PROJECT_ENVIRONMENT"]) / "bin/python")
    for command in commands(lock, platform.machine(), args, python):
        subprocess.run(command, check=True)


if __name__ == "__main__":
    main(sys.argv[1:])
